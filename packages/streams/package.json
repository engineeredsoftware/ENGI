{
  "name": "@bitcode/streams",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility re-export of @bitcode/api/streams (API streaming primitives)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/streams": {
      "types": "./src/streams.ts",
      "default": "./src/streams.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
