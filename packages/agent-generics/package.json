{
  "name": "@bitcode/agent-generics",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "jest",
    "test:core": "jest --testPathPattern=__tests__/core/",
    "test:edges": "jest --testPathPattern=__tests__/edges/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "pnpm run typecheck"
  },
  "dependencies": {
    "@bitcode/execution-generics": "workspace:*",
    "@bitcode/generation-generics": "workspace:*",
    "@bitcode/generic-generations-failsafes": "workspace:*",
    "@bitcode/generic-generations-thinkings": "workspace:*",
    "@bitcode/generic-agents-ptrr": "workspace:*",
    "@bitcode/generic-llms": "workspace:*",
    "@bitcode/prompts": "workspace:*",
    "@bitcode/tools-generics": "workspace:*",
    "@bitcode/pipelines-generics": "workspace:*",
    "@bitcode/logger": "workspace:*",
    "zod": "^3.22.4",
    "@bitcode/measurement-generics": "workspace:*",
    "@bitcode/generic-measurements-measure-agent": "workspace:*",
    "@bitcode/generic-measurements-absolutes": "workspace:*",
    "@bitcode/generic-measurements-needinesses": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agents/factories": "./src/agents/factories.ts",
    "./types": "./src/types.ts",
    "./execution": "./src/execution/index.ts",
    "./generations": "./src/generations/index.ts",
    "./generations/factories": "./src/generations/factories.ts",
    "./generations/llm-bound-factories": "./src/generations/llm-bound-factories.ts",
    "./diagnostics/instrumentation": "./src/diagnostics/instrumentation.ts",
    "./steps/failsafe-sequence": "./src/steps/failsafe-sequence.ts",
    "./steps/factories": "./src/steps/factories.ts",
    "./steps/step-schemas": "./src/steps/step-schemas.ts",
    "./steps/*": "./src/steps/*"
  }
}
