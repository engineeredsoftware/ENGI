{
  "name": "@bitcode/generic-artifacts-patch-kind",
  "version": "0.1.0",
  "private": true,
  "description": "PatchArtifact kind: base Artifact for path+op patchfile(s) (AssetPack patch payloads)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./builders": "./src/builders.ts"
  },
  "scripts": {
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "type-check": "pnpm run typecheck"
  },
  "dependencies": {
    "@bitcode/artifact-generics": "workspace:*",
    "@bitcode/files": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  }
}
