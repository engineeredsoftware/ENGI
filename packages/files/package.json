{
  "name": "@bitcode/files",
  "version": "0.1.0",
  "private": true,
  "description": "File primitives: path, FileOp/FileChange, security validation, FileTracker",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./security": "./src/securityUtils.ts",
    "./src/files": "./src/files.ts",
    "./src/*": "./src/*"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@bitcode/logger": "workspace:*"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  }
}
