{
  "name": "@bitcode/errors",
  "version": "0.1.0",
  "private": true,
  "description": "Unified error primitives shared across Bitcode services.",
  "main": "src/errors.ts",
  "types": "src/errors.ts",
  "exports": {
    ".": {
      "require": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@bitcode/external-telemetry-sentry": "workspace:*"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  }
}
