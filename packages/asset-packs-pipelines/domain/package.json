    "./organization-policy-wallet-authority": "./src/organization-policy-wallet-authority.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "demo:bringup": "ts-node src/dev/bringup-demo.ts",
    "type-check": "pnpm run typecheck"
  },
