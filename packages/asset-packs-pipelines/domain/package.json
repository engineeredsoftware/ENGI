{
  "name": "@bitcode/asset-packs-pipelines-domain",
  "version": "1.0.0",
  "description": "All-three AssetPack pipeline shared domain only (commodity, disclosure, settlement-rights library, BTD helpers, org-policy). Synthesis: @bitcode/asset-packs-pipelines-syntheses-domain; deposit/read co-located under syntheses/{deposit,read}.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./asset-pack-disclosure": "./src/asset-pack-disclosure.ts",
    "./asset-pack-settlement-rights-delivery": "./src/asset-pack-settlement-rights-delivery.ts",
    "./btd-btc-compensation-statements": "./src/btd-btc-compensation-statements.ts",
