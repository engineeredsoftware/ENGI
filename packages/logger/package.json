{
  "name": "@bitcode/logger",
  "version": "0.1.0",
  "description": "Shared logging utilities for the Bitcode monorepo.",
  "main": "src/logger.ts",
  "types": "src/logger.ts",
  "exports": {
    ".": {
      "edge-light": "./src/logger-edge.ts",
      "worker": "./src/logger-edge.ts",
      "browser": "./src/logger-edge.ts",
      "require": "./src/logger.ts",
      "default": "./src/logger.ts"
    }
  },
  "files": [
    "src"
  ],
  "license": "SEE LICENSE IN root",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@bitcode/generic-artifacts-compose": "workspace:*",
    "@bitcode/supabase": "workspace:*",
    "@bitcode/external-telemetry-sentry": "workspace:*"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  }
}
