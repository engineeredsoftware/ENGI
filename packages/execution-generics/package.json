{
  "name": "@bitcode/execution-generics",
  "version": "1.0.0",
  "description": "Execution primitive (state) + composition re-exports of Executor combinators and process-root helpers",
  "main": "src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./Execution": {
      "types": "./src/Execution.ts",
      "default": "./src/Execution.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.js"
    },
    "./prompts/ExecutionPrompt": {
      "types": "./src/prompts/ExecutionPrompt.ts",
      "default": "./src/prompts/ExecutionPrompt.js"
    },
    "./prompts/compose-prompt-layers": {
      "types": "./src/prompts/compose-prompt-layers.ts",
      "default": "./src/prompts/compose-prompt-layers.ts"
    },
    "./prompts/apply-prompt-registry-to-execution-prompt": {
      "types": "./src/prompts/apply-prompt-registry-to-execution-prompt.ts",
      "default": "./src/prompts/apply-prompt-registry-to-execution-prompt.ts"
    },
    "./prompts/build-execution-hierarchy-system-prompt": {
      "types": "./src/prompts/build-execution-hierarchy-system-prompt.ts",
      "default": "./src/prompts/build-execution-hierarchy-system-prompt.ts"
    },
    "./prompts/execution-system-prompt": {
      "types": "./src/prompts/execution-system-prompt.ts",
      "default": "./src/prompts/execution-system-prompt.ts"
    },
    "./execution-registry": {
      "types": "./src/execution-registry.ts",
      "default": "./src/execution-registry.js"
    },
    "./store/registry": {
      "types": "./src/store/registry.ts",
      "default": "./src/store/registry.js"
    },
    "./storage/StorageDestination": {
      "types": "./src/storage/StorageDestination.ts",
      "default": "./src/storage/StorageDestination.js"
    },
    "./signals/ShortCircuitSignal": {
      "types": "./src/signals/ShortCircuitSignal.ts",
      "default": "./src/signals/ShortCircuitSignal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "type-check": "pnpm run typecheck"
  },
  "keywords": [
    "execution",
    "executor",
    "combinators",
    "async"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bitcode/executor-generics": "workspace:*",
    "@bitcode/generic-artifacts-compose": "workspace:*",
    "@bitcode/generic-executors": "workspace:*",
    "@bitcode/generic-executions": "workspace:*",
    "@bitcode/prompts": "workspace:*",
    "@bitcode/registry": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@jest/globals": "^29.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
