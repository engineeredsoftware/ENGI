{
  "name": "@bitcode/generic-agents-agent-measure",
  "version": "0.1.0",
  "description": "MeasureAgent: PTRR measurement agent base over Measurement primitives (shared by absolutes + needinesses category packages)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "pnpm exec jest --config jest.config.cjs --runInBand",
    "test:core": "pnpm exec jest --config jest.config.cjs --runInBand --testPathPattern=__tests__/core/",
    "test:edges": "pnpm exec jest --config jest.config.cjs --runInBand --testPathPattern=__tests__/edges/",
    "type-check": "pnpm run typecheck"
  },
  "dependencies": {
    "@bitcode/agent-generics": "workspace:*",
    "@bitcode/measurement-generics": "workspace:*",
    "@bitcode/prompts": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
