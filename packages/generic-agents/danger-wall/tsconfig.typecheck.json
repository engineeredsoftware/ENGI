{
  "extends": "../../../tsconfig.typecheck.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../../packages/_typecheck-shims/ambient-modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".next",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "src/prompts/agent-prompt-danger-wall.ts",
    "src/prompts/plan-prompt-dangerwall.ts",
    "src/prompts/refine-prompt-dangerwall.ts",
    "src/prompts/retry-prompt-dangerwall.ts",
    "src/prompts/try-prompt-dangerwall.ts"
  ]
}
