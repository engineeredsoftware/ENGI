{
  "name": "@bitcode/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Tracing helpers for Bitcode (JS build).",
  "main": "src/observability.ts",
  "types": "src/observability.ts",
  "exports": {
    ".": {
      "require": "./src/observability.ts",
      "default": "./src/observability.ts"
    },
    "./src/observability": {
      "require": "./src/observability.ts",
      "default": "./src/observability.ts"
    },
    "./src/*": "./src/*",
    "./product-analytics": "./src/product-analytics.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@bitcode/logger": "workspace:*",
    "@bitcode/errors": "workspace:*",
    "ai": "^4.3.16",
    "@vercel/analytics": "^1.0.0",
    "@bitcode/external-telemetry-sentry": "workspace:*",
    "@bitcode/external-telemetry-google": "workspace:*",
    "@bitcode/external-telemetry-vercel": "workspace:*",
    "@bitcode/api": "workspace:*",
    "zod": "^3.22.4",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {},
  "peerDependencies": {},
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  }
}
