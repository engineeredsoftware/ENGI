{
  "name": "@bitcode/security",
  "version": "1.0.0",
  "private": true,
  "description": "Security barrel re-exporting packages/security/* subpackages",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/src/index.ts"
  },
  "dependencies": {
    "@bitcode/security-encryption": "workspace:*",
    "@bitcode/security-credentials": "workspace:*",
    "@bitcode/security-rate-limiting": "workspace:*",
    "@bitcode/security-audit": "workspace:*",
    "@bitcode/security-validation": "workspace:*",
    "@bitcode/security-headers": "workspace:*",
    "@bitcode/security-monitoring": "workspace:*",
    "@bitcode/security-error-handling": "workspace:*",
    "@bitcode/security-twilio": "workspace:*",
    "@bitcode/security-client": "workspace:*"
  }
}
