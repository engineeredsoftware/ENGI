{
  "name": "@bitcode/generic-tools-editing",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./execution-context": {
      "types": "./src/execution-context.ts",
      "default": "./src/execution-context.ts"
    },
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@bitcode/file-editing": "workspace:*",
    "@bitcode/execution-generics": "workspace:*",
    "@bitcode/tools-generics": "workspace:*",
    "zod": "^3.22.4"
  },
  "scripts": {
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  }
}
