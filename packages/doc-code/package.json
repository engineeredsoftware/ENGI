{
  "name": "@bitcode/doc-code",
  "version": "1.0.0",
  "private": true,
  "description": "Compatibility re-export of @bitcode/generic-doc-comments-doc-code",
  "main": "src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./loader": {
      "types": "./src/loaders/doc-code-tool-loader.ts",
      "default": "./loader.cjs"
    },
    "./transformDocCodeTools": {
      "types": "./src/transformDocCodeTools.ts",
      "default": "./transformDocCodeTools.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @bitcode/generic-doc-comments-doc-code build",
    "test": "pnpm --filter @bitcode/generic-doc-comments-doc-code test",
    "typecheck": "pnpm --filter @bitcode/generic-doc-comments-doc-code typecheck",
    "transform": "pnpm --filter @bitcode/generic-doc-comments-doc-code transform"
  },
  "dependencies": {
    "@bitcode/generic-doc-comments-doc-code": "workspace:*"
  }
}
