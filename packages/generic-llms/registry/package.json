{
  "name": "@bitcode/generic-llms",
  "version": "0.1.0",
  "description": "Aggregator registry for nested generic-llms provider packages",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./defaults": "./src/defaults.ts"
  },
  "scripts": {
    "test": "pnpm exec jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "pnpm exec jest --config jest.config.cjs --watch",
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "pnpm run typecheck"
  },
  "dependencies": {
    "@bitcode/llm-generics": "workspace:*",
    "@bitcode/generic-llms-xai": "workspace:*",
    "@bitcode/generic-llms-openai": "workspace:*",
    "@bitcode/generic-llms-anthropic": "workspace:*",
    "@bitcode/generic-llms-google": "workspace:*",
    "@bitcode/generic-llms-defaults": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
