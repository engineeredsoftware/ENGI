    "type-check": "pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  },
  "description": "Bitcode specifying machine (repo metadevelopment): gate proof generators, canon posture, and promotion helpers. Lives under scripts/specifying \u2014 not product domain. Specifying law: root BITCODE_SPECIFYING.md."
