{
  "name": "@bitcode/specifying",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server.js": "./server.js",
    "./public/*": "./public/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/specifying-package-boundary.test.js test/spec-family-promotion-posture.test.js test/v47-*.test.js test/v48-*.test.js",
    "test:historical": "node --test --test-force-exit test/*.test.js",
