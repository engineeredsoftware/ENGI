# =============================================================================
# Bitcode uapi — environment template
# =============================================================================
# Copy to apps/uapi/.env.local and fill values. Do not commit .env.local.
#
# Mental model (read this once):
#
#   ┌─────────────────────┬──────────────────────────────────────────────────┐
#   │ Concern             │ Mechanism / env block                            │
#   ├─────────────────────┼──────────────────────────────────────────────────┤
#   │ Database + Auth     │ §2 Supabase                                      │
#   │ Bitcode user login  │ Wallet (BTC §4 / ETH session) — not GH social    │
#   │ Externals / repos   │ §5 GitHub App (install + claim)                  │
#   │ Supabase "Login w/  │ §3 SUPABASE_AUTH_* (optional social only)        │
#   │ GitHub" button      │                                                  │
#   │ Pipeline inference  │ §6 host + §7 LLM keys                            │
#   └─────────────────────┴──────────────────────────────────────────────────┘
#
# Staging-testnet Supabase is currently used as commercial production data:
#   project ref tkpyosihuouusyaxtbau
#
# ONE GitHub App for every environment:
#   https://github.com/apps/bitcode-github-auxiliary
# =============================================================================


# =============================================================================
# 1) APP ORIGIN & PUBLIC FLAGS
# =============================================================================
# Browser-visible. Local example uses localhost; Vercel uses https://www.bitcode.exchange
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BITCODE_ENV=local
# Wallet network label for product (testnet4 for BTC rails)
NEXT_PUBLIC_BITCODE_BITCOIN_NETWORK=testnet4
# NEXT_PUBLIC_MAINTENANCE_MODE=false
# NEXT_PUBLIC_BITCODE_QA_VERBOSE=true


# =============================================================================
# 2) SUPABASE — database + Auth host (required)
# =============================================================================
# Server and browser URLs should match the same project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/public key>
SUPABASE_ANON_KEY=<anon/public key>
# Prefer service role for server admin paths (name varies by dashboard era):
# Required for marketing waitlist inserts + invoking Edge Function `resend`.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
# Waitlist mail: POST {SUPABASE_URL}/functions/v1/resend (deploy + secrets).
# Optional override:
# BITCODE_RESEND_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/resend
# SUPABASE_SECRET_KEY=<secret key if distinct>
# SUPABASE_PUBLISHABLE_KEY=<publishable key if distinct>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key if exposed to browser>
# Optional / legacy:
# SUPABASE_JWT_SECRET=<jwt secret — often unused by app code>
# SUPABASE_DB_URL=<direct postgres URL for migrations/tools>
# DATABASE_URL=<alias some tools expect>


# =============================================================================
# 3) SUPABASE AUTH — social login providers (OPTIONAL)
# =============================================================================
# GoTrue "Sign in with Google / GitHub" OAuth apps configured in Supabase.
# These are NOT the Bitcode GitHub App used for Externals/repos.
# Leave empty if operators only use wallet auth + GitHub App install.
#
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=
# SUPABASE_AUTH_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_GITHUB_CLIENT_SECRET=
# Legacy aliases (prefer SUPABASE_AUTH_* above):
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=


# =============================================================================
# 4) BITCOIN WALLET AUTH — Bitcode custom provider (wallet connect)
# =============================================================================
# Supabase custom provider id: custom:bitcode-bitcoin
# Client secret must match the provider secret in the Supabase dashboard.
BITCODE_BITCOIN_OAUTH_CLIENT_ID=bitcode-bitcoin-wallet
BITCODE_BITCOIN_OAUTH_CLIENT_SECRET=<shared secret with Supabase custom provider>
BITCODE_BITCOIN_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://<project-ref>.supabase.co
BITCODE_BITCOIN_OAUTH_ALLOWED_REDIRECT_URIS=https://<project-ref>.supabase.co/auth/v1/callback
BITCODE_BITCOIN_OAUTH_SUPABASE_CALLBACK_URL=https://<project-ref>.supabase.co/auth/v1/callback


# =============================================================================
# 5) GITHUB APP — Externals / VCS / install / repos (required for GH product)
# =============================================================================
# ONE app, all environments: https://github.com/apps/bitcode-github-auxiliary
# Install → claim → user_connections.provider=github (installation_id).
#
# Do NOT use retired stag-test apps (e.g. …/bitcode-github-auxillary-stag-test).
#
# App ID + private key → installation tokens (repo list, PR delivery).
# Client ID/secret → App OAuth / setup (still credentials of the SAME App).

NEXT_PUBLIC_GITHUB_APP_PUBLIC_URL=https://github.com/apps/bitcode-github-auxiliary
GITHUB_APP_ID=<numeric App ID for bitcode-github-auxiliary>
GITHUB_PRIVATE_KEY=<RSA PEM: multiline escaped \\n, or base64 PEM — not a file path>
# Preferred client names (used by vcs-generics / generic-vcs):
GITHUB_APP_CLIENT_ID=<GitHub App client ID>
GITHUB_APP_CLIENT_SECRET=<GitHub App client secret>
# Callback after install/OAuth — must be listed on the GitHub App:
# Local:
GITHUB_APP_REDIRECT_URI=http://localhost:3000/api/vcs/github/callback
# Production example:
# GITHUB_APP_REDIRECT_URI=https://www.bitcode.exchange/api/vcs/github/callback
# Fallback redirect names some paths still read:
# VCS_REDIRECT_URI=http://localhost:3000/api/vcs/github/callback
# GITHUB_REDIRECT_URI=http://localhost:3000/api/vcs/github/callback
# GITHUB_WEBHOOK_SECRET=<webhook HMAC if webhooks enabled>

# --- Aliases (optional; set same values if tools expect these names) ---
# Vercel historically used GITHUB_CLIENT_* (code falls back to them):
# GITHUB_CLIENT_ID=<same as GITHUB_APP_CLIENT_ID>
# GITHUB_CLIENT_SECRET=<same as GITHUB_APP_CLIENT_SECRET>
# Older aliases:
# GITHUB_OAUTH_CLIENT_ID=<same as GITHUB_APP_CLIENT_ID>
# GITHUB_OAUTH_CLIENT_SECRET=<same as GITHUB_APP_CLIENT_SECRET>
# Do not use: AUTH_GITHUB_*, SUPABASE_AUTH_GITHUB_* for Externals.


# =============================================================================
# 6) PIPELINE HOST / DISPATCH
# =============================================================================
# Local default: LocalHost. Serverless (Vercel) forces sandbox.
BITCODE_PIPELINE_HOST=local
# BITCODE_PIPELINE_HOST=sandbox
# BITCODE_ENABLE_PIPELINE_HOST_API=false
# BITCODE_PIPELINE_HOST_MAX_RUNTIME_MS=600000
# BITCODE_PIPELINE_SANDBOX_IMAGE=vcr.vercel.com/<team>/bitcode/pipeliner:latest
# Real deposit/read inference (host-side; not only Next):
# BITCODE_ASSET_PACK_REAL_INFERENCE=1
# BITCODE_ASSET_PACK_REAL_INFERENCE_PROFILE=bounded
# Depository hybrid vector (gte-small + pgvector). Product host seeds 1 when unset.
# BITCODE_DEPOSITORY_VECTOR_SEARCH=1
# Explicit off for lexical-only: BITCODE_DEPOSITORY_VECTOR_SEARCH=0
# Operator debug (forwarded into host; not default product law):
# BITCODE_DEBUG_SKIP_FAILSAFES=true
# BITCODE_DEBUG_SKIP_THINKINGS_JUDGE_AND_STRUCTURED_OUTPUT=true
# BITCODE_LOG_FULL_PROMPTS=false


# =============================================================================
# 7) LLM / AI PROVIDER KEYS
# =============================================================================
# At least one provider used by pipeline/host configuration.
ANTHROPIC_API_KEY=<Anthropic API key>
# OPENAI_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# EXA_API_KEY=
# REPLICATE_API_TOKEN=
# PINECONE_API_KEY=


# =============================================================================
# 8) ETHEREUM SETTLEMENT / ERC-1155 (testnet rails; optional for pure UX)
# =============================================================================
# BITCODE_ETHEREUM_RPC_URL=
# BITCODE_ETHEREUM_CHAIN_ID=
# BITCODE_ERC1155_ADDRESS=
# BITCODE_MASTER_ACCOUNT=
# BITCODE_SETTLEMENT_OPERATOR=
# BITCODE_PAYMENT_ATTESTOR=
# BITCODE_DEPLOYER_PRIVATE_KEY=
# BITCODE_QUOTE_SIGNER_KEY=
# BITCODE_COIN_FEE_BPS=
# BITCODE_SPOT_PROVIDER=


# =============================================================================
# 9) OTHER VCS / INTEGRATION OAUTH (optional)
# =============================================================================
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# FIGMA_REDIRECT_URI=http://localhost:3000/api/integrations/figma/callback
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_INSTANCE_URL=https://gitlab.com
# GITLAB_REDIRECT_URI=http://localhost:3000/api/vcs/gitlab/callback
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
# BITBUCKET_REDIRECT_URI=http://localhost:3000/api/vcs/bitbucket/callback


# =============================================================================
# 10) EMAIL / CONTACT — Resend (Edge Function + optional app SMTP)
# =============================================================================
# Server-only — never NEXT_PUBLIC_*.
#
# Waitlist delivery uses Supabase Edge Function `resend` (not Auth SMTP).
# Set the same secrets on the project (CLI), not only in this file:
#   supabase secrets set RESEND_API_KEY=re_... \
#     RESEND_WAITLIST_FROM_EMAIL=waitlist@bitcode.exchange \
#     RESEND_FROM_EMAIL=noreply@bitcode.exchange \
#     RESEND_FROM_NAME=Bitcode
#   supabase functions deploy resend
#
# Resend dashboard: API Keys + verified domain (e.g. bitcode.exchange).
RESEND_API_KEY=<resend_api_key re_...>
# Waitlist-only From (Request access / template "waitlist") — not general product mail.
RESEND_WAITLIST_FROM_EMAIL=waitlist@bitcode.exchange
# General product / raw Edge sends (notifications, future app mail) — not waitlist.
RESEND_FROM_EMAIL=noreply@bitcode.exchange
RESEND_FROM_NAME=Bitcode
# RESEND_WEBHOOK_SECRET=<whsec_...>
#
# Optional app product mail via nodemailer (@bitcode/notifications):
# EMAIL_SMTP_URL=smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
# CONTACT_SUPPORT_EMAIL=support@bitcode.exchange


# =============================================================================
# 11) MOCK FLAGS (unset/false = live product; never enable in production)
# =============================================================================
# NEXT_PUBLIC_MASTER_MOCK_MODE=false
# NEXT_PUBLIC_ENABLE_MOCKS=false
# NEXT_PUBLIC_MOCK_USER_AUXILLARIES=false
# NEXT_PUBLIC_MOCK_GITHUB_ACCOUNTS=false
# NEXT_PUBLIC_MOCK_GITHUB_REPOS=false
# NEXT_PUBLIC_MOCK_GITHUB_BRANCHES=false
# NEXT_PUBLIC_MOCK_GITHUB_COMMITS=false


# =============================================================================
# 12) INFRA / MISC (optional)
# =============================================================================
# REDIS_URL=
# AGENT_IMAGE=
# REGISTRY=
# TMP=/tmp
# TOKENIZERS_PARALLELISM=false
# VERCEL_OIDC_TOKEN=
