{
  "extends": "../../tsconfig.typecheck.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/_typecheck-shims/ambient-modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".next",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "src/tools/**",
    "src/streaming/pipeline-stream.ts"
  ]
}
